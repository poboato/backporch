<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately free of any Jellyfin reference. Discovery is useful to the Jellyfin
    plugin and to a standalone front door alike, and keeping the dependency out is what
    lets the same code serve both without a second implementation.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Backporch.Docker</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.Backporch.Tests" />
  </ItemGroup>

</Project>
